@page "/"

<div class="home-screen">
    <!-- Header -->
    <div class="app-header">
        <div class="brand">
            <span class="brand-icon">🌿</span>
            <div>
                <h1 class="brand-name">EkinAI</h1>
                <p class="brand-desc">AI yordamida o'simlik kasalliklarini aniqlash</p>
            </div>
        </div>
        <button class="icon-btn">🔔</button>
    </div>

    <!-- Banner -->
    <div class="hero-card">
        <div class="hero-text">
            <h2>Pomidor o'simligingiz sog'lig'ini <span class="highlight">AI bilan tekshiring</span></h2>
            <p>Barg rasmini yuklang va kasallikni aniqlang, tavsiyalar oling.</p>
        </div>
        <div class="hero-img">
            <img src="https://images.unsplash.com/photo-1592841200221-a6898f307baa?w=300" alt="Tomato" />
        </div>
    </div>

    <!-- Kartochkalar -->
    <a href="upload" class="action-card main-card">
        <div class="card-info">
            <div class="card-icon">📷</div>
            <div>
                <h3>Tekshiruvni boshlash</h3>
                <p>Barg rasmini yuklang</p>
            </div>
        </div>
        <span class="arrow">❯</span>
    </a>

    <a href="history" class="action-card white-card">
        <div class="card-info">
            <div class="card-icon light">🕒</div>
            <div>
                <h3>Tekshiruvlar tarixi</h3>
                <p>Oldingi natijalarni ko'rish</p>
            </div>
        </div>
        <span class="arrow gray">❯</span>
    </a>

    <a href="tips" class="action-card white-card">
        <div class="card-info">
            <div class="card-icon light">💡</div>
            <div>
                <h3>Maslahat</h3>
                <p>O'simlikni sog'lom saqlash bo'yicha foydali tavsiyalar</p>
            </div>
        </div>
        <span class="arrow gray">❯</span>
    </a>
</div>